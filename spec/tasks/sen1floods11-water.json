{
 "spec_version": "0.2-draft",
 "id": "sen1floods11-water",
 "title": "Surface water segmentation from Sentinel-1 and Sentinel-2 (Sen1Floods11, hand-labelled)",
 "dataset_id": "sen1floods11",
 "task_type": "semantic-segmentation",
 "data": {
  "source_url": "https://github.com/cloudtostreet/Sen1Floods11",
  "revision": null,
  "access": "open",
  "manifest_status": "pending"
 },
 "inputs": {
  "s2": {
   "sensor": "sentinel-2-msi",
   "product": "L1C",
   "quantity": "toa_reflectance",
   "required": true,
   "bands": [
    {
     "band": "B01"
    },
    {
     "band": "B02"
    },
    {
     "band": "B03"
    },
    {
     "band": "B04"
    },
    {
     "band": "B05"
    },
    {
     "band": "B06"
    },
    {
     "band": "B07"
    },
    {
     "band": "B08"
    },
    {
     "band": "B8A"
    },
    {
     "band": "B09"
    },
    {
     "band": "B10"
    },
    {
     "band": "B11"
    },
    {
     "band": "B12"
    }
   ],
   "raster": {
    "stored_dtype": "uint16",
    "scale": 0.0001,
    "offset": 0,
    "nodata": null,
    "unit": "1"
   },
   "grid": {
    "size_px": 512,
    "gsd_m": 10,
    "resampling": "all layers projected to EPSG:4326 at 10 m by the dataset; method not stated"
   },
   "time": {
    "steps": 1,
    "selection": "single"
   },
   "notes": "No cloud or QA mask is provided."
  },
  "s1": {
   "sensor": "sentinel-1-iw",
   "product": "GRD",
   "quantity": "sigma0_backscatter",
   "orbit": "both",
   "required": true,
   "bands": [
    {
     "band": "VV"
    },
    {
     "band": "VH"
    }
   ],
   "raster": {
    "stored_dtype": "float32",
    "scale": 1,
    "offset": 0,
    "nodata": "NaN",
    "unit": "dB"
   },
   "grid": {
    "size_px": 512,
    "gsd_m": 10
   },
   "time": {
    "steps": 1,
    "selection": "single"
   }
  }
 },
 "sample_metadata": {
  "location": "centroid",
  "acquisition_time": "per-step",
  "source_crs": "EPSG:4326",
  "notes": "S1 and S2 dates are given per event (s1_date, s2_date) and can differ."
 },
 "target": {
  "kind": "per-pixel-class",
  "grid": "s2",
  "classes": [
   {
    "index": 0,
    "name": "Not Water"
   },
   {
    "index": 1,
    "name": "Water"
   }
  ],
  "ignore_index": -1,
  "label_source": "hand-labelled chips",
  "nodata": -1
 },
 "splits": {
  "official": {
   "kind": "random",
   "definition": "Random 60-20-20 split of hand-labelled chips, excluding Bolivia (Bonafilia et al. 2020); files splits/flood_handlabeled/flood_{train,valid,test}_data.csv, as in PANGAEA sen1floods11.py. All hand-labelled Bolivia chips are held out as a separate test set.",
   "manifests": {
    "train": {
     "path": "manifests/sen1floods11-water/train.csv",
     "sha256": null,
     "n_samples": null
    },
    "val": {
     "path": "manifests/sen1floods11-water/val.csv",
     "sha256": null,
     "n_samples": null
    },
    "test": {
     "path": "manifests/sen1floods11-water/test.csv",
     "sha256": null,
     "n_samples": null
    }
   },
   "test_labels_public": true
  },
  "extra_tests": [
   {
    "name": "out-of-region",
    "kind": "geographic-regions",
    "status": "defined-by-dataset",
    "definition": "All hand-labelled chips from Bolivia, held out by the dataset authors (Bonafilia et al. 2020)."
   }
  ],
  "label_fractions": {
   "fractions": [
    1.0,
    0.1,
    0.01
   ],
   "stratify_by": "flood event",
   "min_train_samples": 10
  }
 },
 "evaluation": {
  "primary_metric": {
   "name": "mIoU",
   "averaging": "mean of per-class IoU over both classes, pixels pooled over the test set",
   "higher_is_better": true
  },
  "secondary_metrics": [
   {
    "name": "IoU (Water)",
    "averaging": "pixels pooled over the test set",
    "higher_is_better": true
   }
  ],
  "tracks": [
   "frozen-decoder",
   "finetune"
  ],
  "diagnostics": [
   "linear-probe"
  ],
  "inference": "whole 512 × 512 chip; adapters tile or upsample per protocols.json"
 },
