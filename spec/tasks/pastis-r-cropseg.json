 "notes": {
  "harness": [
   "PANGAEA picks time steps by index, not by date, and returns empty metadata, so dates never reach the model (pangaea/datasets/pastis.py, __getitem__).",
   "PANGAEA uses only the ascending Sentinel-1 series; PASTIS-R also has a descending one.",
   "PANGAEA's config lists data_min of -10000 for every S2 band, so no-data pixels appear to be passed to models as values."
  ],
  "open_questions": [
   "Is nearest-centre the right pick without a cloud mask, or should S2 windows use a median composite?"
  ]
 },
