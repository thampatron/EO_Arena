{
 "spec_version": "0.1-draft",
 "id": "pastis-r-cropseg",
 "title": "Crop type segmentation from Sentinel-2 and Sentinel-1 time series (PASTIS-R)",
 "dataset_id": "pastis-pastis-r",
 "task_type": "semantic-segmentation",
 "inputs": {
  "s2": {
   "sensor": "sentinel-2-msi",
   "product": "L2A",
   "quantity": "surface_reflectance",
   "required": true,
   "bands": [
    {
     "band": "B02"
    },
    {
     "band": "B03"
    },
    {
     "band": "B04"
    },
    {
     "band": "B05"
    },
    {
     "band": "B06"
    },
    {
     "band": "B07"
    },
    {
     "band": "B08"
    },
    {
     "band": "B8A"
    },
    {
     "band": "B11"
    },
    {
     "band": "B12"
    }
   ],
   "raster": {
    "stored_dtype": "int16",
    "scale": 0.0001,
    "offset": 0,
    "nodata": -10000,
    "unit": "1"
   },
   "grid": {
    "size_px": 128,
    "gsd_m": 10,
    "resampling": "20 m bands delivered at 10 m by the dataset; method not stated"
   },
   "time": {
    "steps": 6,
    "selection": "6 acquisitions at evenly spaced indices of the series (PANGAEA rule, kept for comparability). The dates of the chosen acquisitions are delivered with them.",
    "compositing": "none"
   },
   "notes": "The full series holds 38–61 acquisitions per patch."
  },
  "s1_asc": {
   "sensor": "sentinel-1-iw",
   "product": "GRD",
   "quantity": "sigma0_backscatter",
   "orbit": "ascending",
   "required": true,
   "bands": [
    {
     "band": "VV"
    },
    {
     "band": "VH"
    },
    {
     "name": "VV/VH",
     "derived_from": "VV - VH"
    }
   ],
   "raster": {
    "stored_dtype": "float32",
    "scale": 1,
    "offset": 0,
    "nodata": null,
    "unit": "dB"
   },
   "grid": {
    "size_px": 128,
    "gsd_m": 10
   },
   "time": {
    "steps": 6,
    "selection": "Same rule as s2, applied independently to the ascending series (about 70 acquisitions), so S1 and S2 steps do not share dates."
   }
  }
 },
 "sample_metadata": {
  "location": "centroid",
  "acquisition_time": "per-step",
  "source_crs": "EPSG:2154",
  "notes": "Dates come from metadata.geojson (dates-S2, dates-S1A)."
 },
 "target": {
  "kind": "per-pixel-class",
  "grid": "s2",
  "classes": [
   {
    "index": 0,
    "name": "Background"
   },
   {
    "index": 1,
    "name": "Meadow"
   },
   {
    "index": 2,
    "name": "Soft Winter Wheat"
   },
   {
    "index": 3,
    "name": "Corn"
   },
   {
    "index": 4,
    "name": "Winter Barley"
   },
   {
    "index": 5,
    "name": "Winter Rapeseed"
   },
   {
    "index": 6,
    "name": "Spring Barley"
   },
   {
    "index": 7,
    "name": "Sunflower"
   },
   {
    "index": 8,
    "name": "Grapevine"
   },
   {
    "index": 9,
    "name": "Beet"
   },
   {
    "index": 10,
    "name": "Winter Triticale"
   },
   {
    "index": 11,
    "name": "Winter Durum Wheat"
   },
   {
    "index": 12,
    "name": "Fruits, Vegetables, Flowers"
   },
   {
    "index": 13,
    "name": "Potatoes"
   },
   {
    "index": 14,
    "name": "Leguminous Fodder"
   },
   {
    "index": 15,
    "name": "Soybeans"
   },
   {
    "index": 16,
    "name": "Orchard"
   },
   {
    "index": 17,
    "name": "Mixed Cereal"
   },
   {
    "index": 18,
    "name": "Sorghum"
   },
   {
    "index": 19,
    "name": "Void Label"
   }
  ],
  "ignore_index": 19,
  "label_source": "French Land Parcel Identification System (RPG) declarations",
  "notes": "Background is non-agricultural land and is scored as a class. Void marks parcels mostly outside the patch."
 },
 "splits": {
  "kind": "buffered-random",
  "definition": "Official 5-fold split in metadata.geojson, folds chosen 'with a 1km buffer between images' (Garnot & Landrieu 2021, §4.1) but interleaved within the same Sentinel-2 tiles; folds 1–3 train, 4 val, 5 test (as in PANGAEA pastis.py).",
  "test_labels_public": true
 },
 "evaluation": {
  "primary_metric": {
   "name": "mIoU",
   "averaging": "mean of per-class IoU over the 19 scored classes, pixels pooled over the test set",
   "higher_is_better": true
  },
  "secondary_metrics": [
   {
    "name": "overall accuracy",
    "averaging": "over scored pixels",
    "higher_is_better": true
   }
  ],
  "protocols": [
   "frozen-linear",
   "frozen-upernet-pangaea"
  ],
  "inference": "sliding window (PANGAEA default for segmentation)",
  "seeds": 3,
  "label_fractions": [
   1.0
  ]
 },
 "normalisation_stats": {
  "source": "PANGAEA configs/dataset/pastis.yaml, converted with the scale above",
