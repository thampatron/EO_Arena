{
 "spec_version": "0.2-draft",
 "id": "pastis-r-cropseg",
 "title": "Crop type segmentation from Sentinel-2 and Sentinel-1 time series (PASTIS-R)",
 "dataset_id": "pastis-pastis-r",
 "task_type": "semantic-segmentation",
 "data": {
  "source_url": "https://zenodo.org/record/5735646",
  "revision": "Zenodo record 5735646 (DOI 10.5281/zenodo.5735646)",
  "access": "open",
  "manifest_status": "pending"
 },
 "inputs": {
  "s2": {
   "sensor": "sentinel-2-msi",
   "product": "L2A (THEIA)",
   "quantity": "surface_reflectance",
   "required": true,
   "bands": [
    {
     "band": "B02"
    },
    {
     "band": "B03"
    },
    {
     "band": "B04"
    },
    {
     "band": "B05"
    },
    {
     "band": "B06"
    },
    {
     "band": "B07"
    },
    {
     "band": "B08"
    },
    {
     "band": "B8A"
    },
    {
     "band": "B11"
    },
    {
     "band": "B12"
    }
   ],
   "raster": {
    "stored_dtype": "int16",
    "scale": 0.0001,
    "offset": 0,
    "nodata": -10000,
    "unit": "1"
   },
   "grid": {
    "size_px": 128,
    "gsd_m": 10,
    "resampling": "all bands resampled to 10 m with bilinear interpolation (PASTIS documentation)"
   },
   "time": {
    "steps": 6,
    "selection": "calendar-windows",
    "windows": {
     "period": "2018-09-01 to 2019-10-31 (acquisitions in metadata.geojson run from 2018-09-17 to 2019-10-27)",
     "n": 6,
     "pick": "nearest-centre",
     "empty_window": "mask-invalid"
    },
    "comparison_rule": "PANGAEA: 6 acquisitions at evenly spaced indices, dates dropped"
   },
   "notes": "38–61 acquisitions per patch. No cloud mask is shipped, so 'clearest' cannot be computed; the acquisition nearest each window centre is used."
  },
  "s1_asc": {
   "sensor": "sentinel-1-iw",
   "product": "GRD",
   "quantity": "sigma0_backscatter",
   "orbit": "ascending",
   "required": true,
   "bands": [
    {
     "band": "VV"
    },
    {
     "band": "VH"
    },
    {
     "name": "VV/VH",
     "derived_from": "VV / VH ratio (whether computed in linear or dB units is not stated)"
    }
   ],
   "raster": {
    "stored_dtype": "float32",
    "scale": 1,
    "offset": 0,
    "nodata": null,
    "unit": "dB"
   },
   "grid": {
    "size_px": 128,
    "gsd_m": 10
   },
   "time": {
    "steps": 6,
    "selection": "calendar-windows",
    "windows": {
     "period": "same six windows as s2",
     "n": 6,
     "pick": "nearest-centre",
     "empty_window": "mask-invalid"
    },
    "comparison_rule": "PANGAEA: 6 acquisitions at evenly spaced indices, dates dropped"
   },
   "notes": "About 70 ascending acquisitions per patch. No speckle filtering or terrain correction (PASTIS-R paper)."
  }
 },
 "sample_metadata": {
  "location": "centroid",
  "acquisition_time": "per-step",
  "source_crs": "EPSG:2154"
 },
 "target": {
  "kind": "per-pixel-class",
  "grid": "s2",
  "classes": [
