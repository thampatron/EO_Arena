  "ignore_index": 19,
  "label_source": "French Land Parcel Identification System (RPG) declarations",
  "notes": "Background is non-agricultural land and is scored as a class. Void marks parcels mostly outside the patch."
 },
 "splits": {
  "official": {
   "kind": "buffered-random",
   "definition": "Official 5-fold split in metadata.geojson, folds chosen 'with a 1km buffer between images' (Garnot & Landrieu 2021, §4.1) but interleaved within the same Sentinel-2 tiles; folds 1–3 train, 4 val, 5 test (as in PANGAEA pastis.py).",
   "manifests": {
    "train": {
     "path": "manifests/pastis-r-cropseg/train.csv",
     "sha256": null,
     "n_samples": 1455
    },
    "val": {
     "path": "manifests/pastis-r-cropseg/val.csv",
     "sha256": null,
     "n_samples": 482
    },
    "test": {
     "path": "manifests/pastis-r-cropseg/test.csv",
     "sha256": null,
     "n_samples": 496
    }
   },
   "test_labels_public": true
  },
  "extra_tests": [
   {
    "name": "out-of-region",
    "kind": "geographic-regions",
    "status": "proposed",
    "definition": "Hold out every patch of Sentinel-2 tile T32ULU (556 patches, the only tile in UTM zone 32); train and validate on tiles T31TFM, T31TFJ and T30UXV."
   }
  ],
  "label_fractions": {
   "fractions": [
    1.0,
    0.1,
    0.01
   ],
   "stratify_by": "majority crop class of the patch",
   "min_train_samples": 10
  }
 },
 "evaluation": {
  "primary_metric": {
   "name": "mIoU",
   "averaging": "mean of per-class IoU over the 19 scored classes, pixels pooled over the test set",
   "higher_is_better": true
  },
  "secondary_metrics": [
   {
    "name": "overall accuracy",
    "averaging": "over scored pixels",
    "higher_is_better": true
   }
  ],
  "tracks": [
   "frozen-decoder",
   "finetune"
  ],
  "diagnostics": [
   "linear-probe"
  ],
  "inference": "whole 128 × 128 patch; adapters tile or upsample per protocols.json"
 },
