{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thampatron/EO_Arena/spec/task.schema.json",
  "title": "EOArena task template",
  "description": "Version 0.2-draft. Fixes what a model is given, what it must predict and how it is scored. Rules shared by every task (tensor layout, units, masks, runs, tuning, reporting) live in spec/protocols.json and docs/task-template.md. Only the required core is fixed; extra fields are allowed until v1.",
  "type": "object",
  "required": ["spec_version", "id", "title", "dataset_id", "task_type", "data", "inputs", "sample_metadata", "target", "splits", "evaluation", "provenance", "unverified"],
  "properties": {
    "spec_version": {"const": "0.2-draft"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "dataset_id": {"type": "string", "description": "Record id in data/datasets.json, which supplies domain, subdomain and licence."},
    "task_type": {"enum": ["classification", "multilabel-classification", "semantic-segmentation", "pixel-regression", "image-regression", "change-detection", "object-detection"]},

    "data": {
      "type": "object",
      "description": "Where the exact data come from. Decision 9.",
      "required": ["source_url", "revision", "access", "manifest_status"],
      "properties": {
        "source_url": {"type": "string", "pattern": "^https?://"},
        "revision": {"type": ["string", "null"], "description": "Pinned version: a commit hash, DOI version or archive checksum. Null until pinned."},
        "access": {"enum": ["open", "gated", "registration"]},
        "manifest_status": {"enum": ["pending", "published"], "description": "Published once every split has a manifest with per-file SHA-256."}
      }
    },

    "inputs": {
      "type": "object",
      "description": "One entry per modality. Each is delivered as a (T, C, H, W) array with a (T, H, W) boolean valid mask, true = valid.",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/modality"}
    },

    "sample_metadata": {
      "type": "object",
      "required": ["location", "acquisition_time"],
      "properties": {
        "location": {"enum": ["centroid", "bbox", "none"], "description": "Delivered as {lon, lat} in EPSG:4326."},
        "acquisition_time": {"enum": ["per-step", "per-sample", "none"], "description": "Delivered as ISO 8601 UTC dates."},
        "source_crs": {"type": "string"}
      }
    },

    "target": {
      "type": "object",
      "required": ["kind", "grid", "label_source"],
      "properties": {
        "kind": {"enum": ["class", "multilabel", "per-pixel-class", "per-pixel-value", "value", "change-mask", "boxes"]},
        "grid": {"type": "string", "description": "Input modality whose grid the target shares, or 'none' for image-level targets. Metrics are computed on this grid; labels are never resampled to fit a model."},
        "classes": {"type": "array", "items": {"type": "object", "required": ["index", "name"], "properties": {"index": {"type": "integer"}, "name": {"type": "string"}}}},
        "ignore_index": {"type": ["integer", "null"]},
        "quantity": {"type": "string"},
        "unit": {"type": "string"},
        "nodata": {"type": ["number", "null"]},
        "label_source": {"type": "string"}
      }
    },

    "splits": {
      "type": "object",
      "required": ["official", "extra_tests", "label_fractions"],
      "properties": {
        "official": {
          "type": "object",
          "required": ["kind", "definition", "manifests"],
          "properties": {
            "kind": {"$ref": "#/$defs/split_kind"},
            "definition": {"type": "string"},
            "manifests": {"type": "object", "required": ["train", "val", "test"], "properties": {"train": {"$ref": "#/$defs/manifest"}, "val": {"$ref": "#/$defs/manifest"}, "test": {"$ref": "#/$defs/manifest"}}},
            "test_labels_public": {"type": ["boolean", "null"]}
          }
        },
        "extra_tests": {
          "type": "array",
          "description": "Additional test sets, above all an out-of-region one. Decision 3.",
          "items": {
            "type": "object",
            "required": ["name", "kind", "definition", "status"],
            "properties": {
              "name": {"type": "string"},
              "kind": {"$ref": "#/$defs/split_kind"},
              "definition": {"type": "string"},
              "status": {"enum": ["defined-by-dataset", "proposed", "not-possible"]},
              "manifest": {"$ref": "#/$defs/manifest"}
            }
          }
        },
        "label_fractions": {
          "type": "object",
          "description": "Nested, stratified training subsets, one subset per run. Decision 6.",
          "required": ["fractions", "stratify_by", "min_train_samples"],
          "properties": {
            "fractions": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "minItems": 1},
            "stratify_by": {"type": "string"},
            "min_train_samples": {"type": "integer", "minimum": 1}
          }
        }
      }
    },

    "evaluation": {
      "type": "object",
      "required": ["primary_metric", "tracks"],
      "properties": {
        "primary_metric": {"$ref": "#/$defs/metric"},
        "secondary_metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "tracks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Ranked tracks from spec/protocols.json."},
        "diagnostics": {"type": "array", "items": {"type": "string"}, "description": "Unranked diagnostics from spec/protocols.json."},
        "inference": {"type": "string"}
      }
    },

    "normalisation_stats": {
      "type": "object",
      "description": "Optional. Per-band statistics in physical units, used only for models that ship none. Decision 8.",
      "required": ["source", "computed_on"],
      "properties": {
        "source": {"type": "string"},
        "computed_on": {"type": "string"},
        "per_modality": {"type": "object", "additionalProperties": {"type": "object", "required": ["mean", "std"], "properties": {"mean": {"type": "array", "items": {"type": "number"}}, "std": {"type": "array", "items": {"type": "number"}}}}}
      }
    },

    "notes": {
      "type": "object",
      "description": "Optional and not normative: differences in existing harnesses, open questions.",
      "properties": {
        "harness": {"type": "array", "items": {"type": "string"}},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    },

    "provenance": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "url"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}}}}
      }
    },
    "unverified": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "description": "JSON Pointers to every field not confirmed by a primary source."}
  },

  "$defs": {
    "split_kind": {"enum": ["random", "buffered-random", "spatial-blocks", "geographic-regions", "temporal", "predefined-unknown"]},
    "manifest": {
      "type": "object",
      "required": ["path", "sha256", "n_samples"],
      "properties": {
        "path": {"type": "string", "description": "CSV with sample_id, relpath, sha256, bytes (see scripts/make_manifest.py)."},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "Hash of the manifest file itself. Null while pending."},
        "n_samples": {"type": ["integer", "null"]}
      }
    },
    "modality": {
      "type": "object",
      "required": ["sensor", "bands", "raster", "grid", "time"],
      "properties": {
        "sensor": {"type": "string", "description": "Key in data/sensor_specs.json."},
        "product": {"type": "string"},
        "quantity": {"enum": ["toa_reflectance", "surface_reflectance", "sigma0_backscatter", "gamma0_backscatter", "brightness_temperature", "radiance", "elevation", "probability", "other"]},
        "orbit": {"enum": ["ascending", "descending", "both", "unknown"]},
        "required": {"type": "boolean"},
        "bands": {
          "type": "array",
          "minItems": 1,
          "description": "Channel order of the delivered array.",
          "items": {
            "type": "object",
            "properties": {
              "band": {"type": "string", "description": "Band name in the sensor registry."},
              "name": {"type": "string"},
              "derived_from": {"type": "string", "description": "Formula over registry bands, for derived layers."},
              "auxiliary": {"type": "string", "description": "Non-spectral layer shipped with the modality, e.g. cloud probability."}
            },
            "oneOf": [{"required": ["band"]}, {"required": ["name", "derived_from"]}, {"required": ["name", "auxiliary"]}]
          }
        },
        "raster": {
          "type": "object",
          "description": "physical = stored * scale + offset (STAC raster extension). Pixels equal to nodata are marked invalid, never passed as values.",
          "required": ["stored_dtype", "scale", "offset", "nodata", "unit"],
          "properties": {
            "stored_dtype": {"type": "string"},
            "scale": {"type": ["number", "null"]},
            "offset": {"type": ["number", "null"]},
            "nodata": {"type": ["number", "string", "null"]},
            "unit": {"type": "string"}
          }
        },
        "grid": {
          "type": "object",
          "required": ["size_px", "gsd_m"],
          "properties": {
            "size_px": {"oneOf": [{"type": "integer"}, {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}]},
            "gsd_m": {"type": "number"},
            "resampling": {"type": "string"}
          }
        },
        "time": {
          "type": "object",
          "description": "Decision 2: multi-step inputs are selected by calendar window, not by index.",
          "required": ["steps", "selection"],
          "properties": {
            "steps": {"type": "integer", "minimum": 1},
            "selection": {"enum": ["single", "calendar-windows"]},
            "windows": {
              "type": "object",
              "required": ["period", "n"],
              "properties": {
                "period": {"type": "string", "description": "Season covered, as ISO dates or a rule relative to the label date."},
                "n": {"type": "integer"},
                "pick": {"enum": ["clearest", "nearest-centre", "median-composite", "mean-composite", "as-provided"]},
                "empty_window": {"const": "mask-invalid"}
              }
            },
            "comparison_rule": {"type": "string", "description": "An existing harness's selection rule, run once only to measure the difference."}
          },
          "if": {"properties": {"selection": {"const": "calendar-windows"}}},
          "then": {"required": ["windows"]}
        }
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "averaging", "higher_is_better"],
      "properties": {
        "name": {"type": "string"},
        "averaging": {"type": "string"},
        "higher_is_better": {"type": "boolean"}
      }
    }
  }
}
